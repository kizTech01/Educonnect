# Local development settings. Copy this file to .env and replace the secret
# before deploying. The .env file is intentionally excluded from Git.
DJANGO_DEBUG=True
DJANGO_USE_LOCAL_SQLITE=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-production
DJANGO_TIME_ZONE=Africa/Lagos

# Leave CORE_DOMAIN empty for local development. In production set the public
# platform host, for example: educonnect.example.edu
CORE_DOMAIN=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Email defaults to Django's console backend, which prints messages locally.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=EduConnect <noreply@example.test>

# Optional: create the first administrator on startup. Leave these blank until
# you have chosen unique credentials; never commit real values.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# Production services normally provide DATABASE_URL. Set this only when using
# a remote PostgreSQL database; keep DJANGO_USE_LOCAL_SQLITE=True locally.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Leave empty locally. On a host with a persistent media volume, set this to
# that volume's absolute mount path.
DJANGO_MEDIA_ROOT=

# Cloudflare R2 is required when DJANGO_DEBUG=False. Leave every R2 variable
# empty for local development to use the local media directory. Never commit
# real credentials. R2 buckets must remain private.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_DEFAULT_ACL=private
AWS_QUERYSTRING_AUTH=True

# Optional AI features.
OPENAI_API_KEY=
OPENAI_AUTOMATION_MODEL=gpt-4.1-mini
OPENAI_LOGO_LOOKUP_MODEL=gpt-5
OPENAI_LOGO_PROCESSING_MODEL=gpt-image-2
