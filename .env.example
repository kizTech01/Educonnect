# Local development configuration. Copy this file to .env and replace values
# marked as required before using the corresponding feature.
DJANGO_DEBUG=True
DJANGO_USE_LOCAL_SQLITE=True
DJANGO_SECRET_KEY=replace-with-a-long-random-local-development-secret
DJANGO_TIME_ZONE=Africa/Lagos

# Comma-separated host names used outside local development.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Optional SMTP delivery. The console email backend is safe for local use.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=EduConnect <noreply@localhost>

# Optional OpenAI-powered document processing.
OPENAI_API_KEY=
OPENAI_AUTOMATION_MODEL=gpt-4.1-mini
OPENAI_LOGO_LOOKUP_MODEL=gpt-5
OPENAI_LOGO_PROCESSING_MODEL=gpt-image-2

# Optional administrator created on first request only.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
