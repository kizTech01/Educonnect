# Copy to .env.production only for the Docker/Caddy deployment.
# Generate a unique random value for every secret; never commit the copied file.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_TIME_ZONE=Africa/Lagos
DJANGO_ALLOWED_HOSTS=portal.example.edu.ng
CSRF_TRUSTED_ORIGINS=https://portal.example.edu.ng

CADDY_DOMAIN=portal.example.edu.ng
CADDY_EMAIL=ops@example.edu.ng

POSTGRES_DB=educonnect
POSTGRES_USER=educonnect
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://educonnect:replace-with-a-strong-database-password@db:5432/educonnect

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=EduConnect <noreply@portal.example.edu.ng>

BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
